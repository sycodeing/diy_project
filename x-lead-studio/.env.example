DIY_SITE_URL=http://localhost:3000
MARKETING_INGEST_SECRET=replace-with-the-same-32-byte-secret-as-the-diy-site
VISION_MODE=manual
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4.1-mini
DEFAULT_X_QUERY=("gotcha day" OR "pet birthday") (dog OR cat OR puppy OR kitten) filter:images -filter:replies lang:en
MIN_LEAD_SCORE=70
AUTO_COLLECTION_ENABLED=true
AUTO_COLLECTION_DAILY_LIMIT=40
US_REQUIRED=true
US_MIN_CONFIDENCE=70

# Shared read-only candidate discovery worker. The secret must match the website.
X_LEAD_WORKER_ENABLED=true
X_LEAD_WORKER_SECRET=replace-with-a-separate-32-byte-secret
X_LEAD_WORKER_POLL_SECONDS=30

# Download prepared manual-post previews into a dated local folder.
PREVIEW_DOWNLOAD_WORKER_ENABLED=true
PREVIEW_DOWNLOAD_ROOT=D:\Temu\Photo\待发送
PREVIEW_DOWNLOAD_POLL_SECONDS=10

# Preferred read-only discovery provider. The token remains on this computer.
# When configured, the shared worker uses Apify instead of the local X cookie search.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=KvRrkwDDFm4vmklVv
# Safety cap for one Actor run.
APIFY_MAX_CHARGE_USD=1.00

# Reviewed automatic post/reply worker. The secret must match the website's X_REPLY_WORKER_SECRET.
X_REPLY_WORKER_ENABLED=true
X_REPLY_WORKER_SECRET=replace-with-a-separate-32-byte-secret
X_REPLY_WORKER_POLL_SECONDS=15
# Keep x-use cookies and journals local. This directory is never uploaded.
X_USE_HOME=C:\Users\Administrator\AppData\Local\x-use
