NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public callback origin for email confirmations opened on another device.
# Use the deployed website URL here, not localhost.
NEXT_PUBLIC_AUTH_REDIRECT_URL=
# Public customer-support contacts shown on the Contact page and site footer.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
# Local-only override. Omit this on Vercel so the app uses /api/mockup.
NEXT_PUBLIC_MOCKUP_RENDERER_URL=http://127.0.0.1:8010
NEXT_PUBLIC_ALLOWED_COUNTRIES=US,CN
# Optional regional allowlist. Separate entries with |, for example US:CA|US:NY|CN:GD
NEXT_PUBLIC_ALLOWED_REGIONS=

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy Supabase keys are also supported by the code.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
# Keep false until Stripe Tax has a real head-office address and valid registrations.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# PayPal REST app credentials. Keep the secret server-only.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Shared only with the local x-lead-studio. Use at least 32 random bytes.
MARKETING_INGEST_SECRET=your-long-random-marketing-ingest-secret

TEMU_SYNC_SECRET=your-shared-secret-for-temu-imports

# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=your-long-random-cron-secret
